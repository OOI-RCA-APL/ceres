{
  "name": "ceres-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi generate",
    "postbuild": "rm -rf ../ceres/static/console && cp -R .output/public ../ceres/static/console",
    "serve": "nuxi preview",
    "postinstall": "nuxi prepare",
    "lint": "nuxi typecheck && eslint . && prettier --check .",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest run"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "singleQuote": true
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.10.0",
    "@pinia/nuxt": "^1.0.2",
    "@tanstack/vue-query": "^5.101.4",
    "@vue-macros/nuxt": "^3.1.4",
    "@vueuse/core": "^14.4.0",
    "ajv": "^8.20.0",
    "color": "^5.0.3",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "lodash-es": "^4.18.1",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "prismjs": "^1.30.0",
    "tailwindcss": "^4.3.3",
    "title-case": "^4.3.2",
    "uuid": "^14.0.1",
    "validator": "^13.15.35",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@vue-macros/nuxt": {
      "nuxt": ">=3.0.0"
    }
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@types/color": "^4.2.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@types/prismjs": "^1.26.6",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vue-macros": "^3.1.4",
    "vue-tsc": "^3.3.9"
  }
}
